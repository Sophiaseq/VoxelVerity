        <mxCell id="possessed" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#DCFCE7;color:#166534;border:1px solid #86EFAC;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;SERVER&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;Possess → Pawn 初始化&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;AMGCharacter::PossessedBy(NewController)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;PawnExt-&amp;gt;HandleControllerChanged()&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;→ CheckDefaultInitialization()&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;InitState: Spawned → DataAvailable → DataInitialized → GameplayReady&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ECFEFF;strokeColor=#06B6D4;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1325.0" y="4592.0" width="525.0" height="175.0" />
        </mxCell>
        <mxCell id="ascInit" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#F3E8FF;color:#6B21A8;border:1px solid #D8B4FE;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;GAS&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;AbilitySystem 初始化&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;AMGCharacter::OnAbilitySystemInitialized()&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;HealthComponent-&amp;gt;InitializeWithAbilitySystem(MGASC)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;AMGCharacterWithAbilities::SetPawnData() 授予 AbilitySets（authority）&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;客户端通过 OnRep_PawnData / PostReplicatedPawnData 重建表现。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1900.0" y="4592.0" width="550.0" height="175.0" />
        </mxCell>
        <mxCell id="pawnNote" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#FFEDD5;color:#9A3412;border:1px solid #FDBA74;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;CHECK&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;维护提示&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;SetPawnData&lt;/span&gt; 只允许在 authority 上设置；已有 PawnData 会报错并 return。&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;BP 覆写 SpawnDefaultPawnAtTransform 时，必须调用 Parent 才能复用上述逻辑。&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
