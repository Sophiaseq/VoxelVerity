        <mxCell id="destroy" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#FEE2E2;color:#991B1B;border:1px solid #FCA5A5;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;SERVER&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;AMGCharacter::DestroyDueToDeath / UninitAndDestroy&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;K2_OnDeathFinished();&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (LocalRole == ROLE_Authority) {&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;  DetachFromControllerPendingDestroy(); SetLifeSpan(1.0f); }&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (MGASC-&amp;gt;GetAvatarActor() == this) PawnExt-&amp;gt;UninitializeAbilitySystem();&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;SetActorHiddenInGame(true);&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="700.0" y="2352.0" width="650.0" height="175.0" />
        </mxCell>
        <mxCell id="detach" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#E5E7EB;color:#374151;border:1px solid #CBD5E1;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;CONTROLLER&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;DetachFromControllerPendingDestroy&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;Controller-&amp;gt;PawnPendingDestroy(this);&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;Controller-&amp;gt;UnPossess(); SetController(nullptr);&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;AController::PawnPendingDestroy → UnPossess(); ChangeState(NAME_Inactive);&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="700.0" y="2576.0" width="650.0" height="154.0" />
        </mxCell>
        <mxCell id="lifespan" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#FEE2E2;color:#991B1B;border:1px solid #FCA5A5;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;CLEANUP&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;生命周期收尾&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;SetLifeSpan(1.0f);&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;SetActorHiddenInGame(true);&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1400.0" y="2576.0" width="525.0" height="140.0" />
