        <mxCell id="spawnMgr" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#FFFBEB;color:#B45309;border:1px solid #FCD34D;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;★ KEY&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;UMGPlayerSpawningManagerComponent::HandlePawnDeathStarted&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (AController* C = Pawn-&amp;gt;GetController())&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;  DeathTransforms.Add(C, Pawn-&amp;gt;GetActorTransform());&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;★ 这就是重生时 ChoosePlayerStart 读取的坐标。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
