        </mxCell>
        <mxCell id="deathTransform" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#FEF9C3;color:#854D0E;border:1px solid #FDE047;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;IF&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;DeathTransforms.Find(Player)?&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (const FTransform* DeathTransform = ...)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;true → 在死亡位置生成临时 PlayerStart&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;false → 继续正常选点&lt;/div&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEFCE8;strokeColor=#CA8A04;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
