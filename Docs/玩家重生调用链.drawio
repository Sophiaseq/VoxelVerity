        <mxCell id="pie" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#E5E7EB;color:#374151;border:1px solid #CBD5E1;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;EDITOR ONLY&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;WITH_EDITOR：Play From Here?&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;#if WITH_EDITOR&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (APlayerStart* S = FindPlayFromHereStart(Player)) return S;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;仅 PIE 有效；优先于缓存点。&lt;/div&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="75.0" y="3695.9999999999995" width="400.0" height="182.0" />
        </mxCell>
        <mxCell id="pieNote" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#E5E7EB;color:#374151;border:1px solid #CBD5E1;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;EDITOR&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;FindPlayFromHereStart&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;Player-&amp;gt;IsA&amp;lt;APlayerController&amp;gt;()&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;TActorIterator&amp;lt;APlayerStart&amp;gt; → IsA&amp;lt;APlayerStartPIE&amp;gt;()&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;返回第一个 PIE PlayerStart。&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="525.0" y="3695.9999999999995" width="525.0" height="140.0" />
        </mxCell>
        <mxCell id="loop" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#FEF3C7;color:#92400E;border:1px solid #FCD34D;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;LOOP&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;↻ 遍历 CachedPlayerStarts&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;for (auto It = CachedPlayerStarts.CreateIterator(); It; ++It)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (APlayerStart* S = (*It).Get()) StarterPoints.Add(S);&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;else It.RemoveCurrent();&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;循环同时清理失效的弱引用。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="75.0" y="3947.9999999999995" width="625.0" height="175.0" />
        </mxCell>
