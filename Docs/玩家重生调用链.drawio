        <mxCell id="row8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=2;fontSize=11;fontColor=#1F2937;" value="&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.45;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#0F172A;&quot;&gt;08 · 首次生成 / Experience 加载&lt;/div&gt;&lt;div style=&quot;margin-top:6px;&quot;&gt;&lt;b style=&quot;color:#075985;&quot;&gt;改哪里：&lt;/b&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;AMGGameMode::OnExperienceLoaded&lt;/span&gt; 循环&lt;br&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;HandleStartingNewPlayer_Implementation&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:4px;&quot;&gt;&lt;b style=&quot;color:#991B1B;&quot;&gt;契约/陷阱：&lt;/b&gt;Experience 未加载时 HandleStartingNewPlayer 直接 return；加载后仅对 Pawn==nullptr 且 PlayerCanRestart 的 PC 调 RestartPlayer。&lt;/div&gt;&lt;div style=&quot;margin-top:4px;&quot;&gt;&lt;b style=&quot;color:#374151;&quot;&gt;证据：&lt;/b&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;MGGameMode.cpp:223&lt;/span&gt;，&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;:349&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
