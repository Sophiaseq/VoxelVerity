        <mxCell id="row4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=2;fontSize=11;fontColor=#1F2937;" value="&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.45;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#0F172A;&quot;&gt;04 · 生成 / 初始化 Pawn&lt;/div&gt;&lt;div style=&quot;margin-top:6px;&quot;&gt;&lt;b style=&quot;color:#075985;&quot;&gt;改哪里：&lt;/b&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;AMGGameMode::SpawnDefaultPawnAtTransform_Implementation&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;UMGPawnExtensionComponent::SetPawnData&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:4px;&quot;&gt;&lt;b style=&quot;color:#991B1B;&quot;&gt;契约/陷阱：&lt;/b&gt;SetPawnData 仅 authority；已有 PawnData 会报错并 return；bDeferConstruction 后必须 FinishSpawning。&lt;/div&gt;&lt;div style=&quot;margin-top:4px;&quot;&gt;&lt;b style=&quot;color:#374151;&quot;&gt;证据：&lt;/b&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;MGGameMode.cpp:90&lt;/span&gt;；&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;MGPawnExtensionComponent.cpp:38&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="320" width="2120" x="40" y="1176" as="geometry" />
        </mxCell>
        <mxCell id="row5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=2;fontSize=11;fontColor=#1F2937;" value="&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.45;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#0F172A;&quot;&gt;05 · 自定义触发（技能 / UI）&lt;/div&gt;&lt;div style=&quot;margin-top:6px;&quot;&gt;&lt;b style=&quot;color:#075985;&quot;&gt;改哪里：&lt;/b&gt;Server RPC →&lt;br&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;AMGGameMode::RequestPlayerRestartNextFrame(Controller, bForceReset)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:4px;&quot;&gt;&lt;b style=&quot;color:#991B1B;&quot;&gt;契约/陷阱：&lt;/b&gt;必须 server；非 APlayerController 不排程；bForceReset=true 会 Reset 到 Spectating+waiting 并清空 StartSpot；false 时旧 StartSpot 可能让 FindPlayerStart 跳过选点。&lt;/div&gt;&lt;div style=&quot;margin-top:4px;&quot;&gt;&lt;b style=&quot;color:#374151;&quot;&gt;证据：&lt;/b&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;MGGameMode.cpp:183&lt;/span&gt;；BP &lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;BP_MGPlayerController::ServerRequestRespawn&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
