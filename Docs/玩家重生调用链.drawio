        <mxCell id="click" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#DBEAFE;color:#1D4ED8;border:1px solid #93C5FD;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;CLIENT&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;WBP_RestartButton::OnClicked&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;GetOwningPlayer()&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;Cast&amp;lt;BP_MGPlayerController&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;ServerRequestRespawn()&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;RemoveFromParent()&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
