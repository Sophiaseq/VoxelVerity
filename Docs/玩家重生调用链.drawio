        <mxCell id="page_title" link="data:page/id,page-01" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=24;fontColor=#1F2937;" value="&lt;div style=&quot;font-size:24px;font-weight:bold;color:#0F172A;&quot;&gt;重生系统 · 扩展点、契约与排障&lt;/div&gt;" vertex="1">
