        <mxCell id="restart" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#E5E7EB;color:#374151;border:1px solid #CBD5E1;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;ENGINE&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;AGameModeBase::RestartPlayer(NewPlayer)&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (!NewPlayer || NewPlayer-&amp;gt;IsPendingKillPending()) return;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;AActor* StartSpot = FindPlayerStart(NewPlayer);&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (StartSpot == nullptr) StartSpot = NewPlayer-&amp;gt;StartSpot;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;RestartPlayerAtPlayerStart(NewPlayer, StartSpot);&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="75.0" y="2001.9999999999998" width="525.0" height="175.0" />
        </mxCell>
        <mxCell id="findStart" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#E5E7EB;color:#374151;border:1px solid #CBD5E1;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;ENGINE&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;AGameModeBase::FindPlayerStart_Implementation&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;IncomingName 非空 → 匹配 PlayerStartTag&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (ShouldSpawnAtStartSpot(Player)) return Player-&amp;gt;StartSpot; // 跳过 ChoosePlayerStart&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;BestStart = ChoosePlayerStart(Player);&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (BestStart == nullptr) BestStart = World-&amp;gt;GetWorldSettings();&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="75.0" y="2198.0" width="600.0" height="175.0" />
        </mxCell>
        <mxCell id="worldSettings" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#FEE2E2;color:#991B1B;border:1px solid #FCA5A5;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;PITFALL&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;⚠ 选点失败会回退到 WorldSettings&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;World-&amp;gt;GetWorldSettings()&lt;/span&gt; 不是空指针！&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;结果：Pawn 会在世界原点附近生成，而不是报错退出。&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;排查“复活到原点”时优先看这里。&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="750.0" y="2198.0" width="525.0" height="154.0" />
        </mxCell>
        <mxCell id="restartAtStart" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#E5E7EB;color:#374151;border:1px solid #CBD5E1;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;ENGINE&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;AGameModeBase::RestartPlayerAtPlayerStart&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (!StartSpot) { log warning; return; }&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (MustSpectate(Cast&amp;lt;APlayerController&amp;gt;(NewPlayer))) return;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (NewPlayer-&amp;gt;GetPawn()) SpawnRotation = Pawn-&amp;gt;GetActorRotation();&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;else if (DefaultPawnClass) SpawnDefaultPawnFor(...)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="75.0" y="2450.0" width="575.0" height="175.0" />
        </mxCell>
        <mxCell id="spawnFor" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#E0F2FE;color:#0369A1;border:1px solid #7DD3FC;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;PROJECT&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;SpawnDefaultPawnFor / AtTransform&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;SpawnDefaultPawnFor(NewPlayer, StartSpot)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;→ SpawnDefaultPawnAtTransform(NewPlayer, Transform)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;项目在 AMGGameMode 中覆写；BP_MGGameMode 也可覆写。&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;详见 ⑤ Pawn 生成。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="700.0" y="2450.0" width="525.0" height="154.0" />
        </mxCell>
        <mxCell id="pawnValid" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#FEF9C3;color:#854D0E;border:1px solid #FDE047;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;IF&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;NewPlayer-&amp;gt;GetPawn() 有效？&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (!IsValid(NewPlayer-&amp;gt;GetPawn()))&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;false → FailedToRestartPlayer&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;true → InitStartSpot + FinishRestartPlayer&lt;/div&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEFCE8;strokeColor=#CA8A04;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1275.0" y="2450.0" width="350.0" height="196.0" />
        </mxCell>
        <mxCell id="failure" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#FEE2E2;color:#991B1B;border:1px solid #FCA5A5;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;FAIL&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;AGameModeBase::FailedToRestartPlayer&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;NewPlayer-&amp;gt;FailedToSpawnPawn();&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;控制器不会重新生成 Pawn。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1725.0" y="2450.0" width="425.0" height="140.0" />
        </mxCell>
        <mxCell id="finish" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#FFFBEB;color:#B45309;border:1px solid #FCD34D;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;PROJECT&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;AMGGameMode::FinishRestartPlayer（覆写）&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (PlayerSpawningComponent)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;  PlayerSpawningComponent-&amp;gt;FinishRestartPlayer(...);&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;Super::FinishRestartPlayer(NewPlayer, StartRotation);&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;组件策略先执行，然后才 Possess。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="700.0" y="2702.0" width="525.0" height="154.0" />
        </mxCell>
        <mxCell id="superFinish" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#E5E7EB;color:#374151;border:1px solid #CBD5E1;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;ENGINE&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;AGameModeBase::FinishRestartPlayer&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;NewPlayer-&amp;gt;Possess(NewPlayer-&amp;gt;GetPawn());&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (!IsValid(Pawn)) FailedToRestartPlayer();&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;ClientSetRotation(Pawn-&amp;gt;GetActorRotation(), true);&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;SetControlRotation(StartRotation); SetPlayerDefaults(Pawn);&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;K2_OnRestartPlayer(NewPlayer);&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1275.0" y="2702.0" width="575.0" height="203.0" />
        </mxCell>
        <mxCell id="k2Restart" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#F3E8FF;color:#6B21A8;border:1px solid #D8B4FE;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;BP HOOK&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;K2_OnRestartPlayer&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;蓝图扩展点（GameMode）&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;此时 Pawn 已 Possess，ASC 初始化可能仍在进行。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=2;dashed=1;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1900.0" y="2702.0" width="400.0" height="133.0" />
        </mxCell>
        <mxCell id="startNull" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#FEE2E2;color:#991B1B;border:1px solid #FCA5A5;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;RETURN&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;直接调用 RestartPlayerAtPlayerStart 且 StartSpot==null&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;log warning; return;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;与 RestartPlayer 不同，这里不会回退 WorldSettings。&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="75.0" y="2702.0" width="575.0" height="125.99999999999999" />
        </mxCell>
        <mxCell id="mustSpectate" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#FEE2E2;color:#991B1B;border:1px solid #FCA5A5;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;RETURN&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;MustSpectate 早退&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (MustSpectate(PC)) { log verbose; return; }&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;纯观战玩家不会生成 Pawn。&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="75.0" y="2884.0" width="575.0" height="133.0" />
        </mxCell>
        <mxCell id="bpOverrideNote" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#F3E8FF;color:#6B21A8;border:1px solid #D8B4FE;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;BP&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;BP 资产层覆写检查&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;BP_MGGameMode&lt;/span&gt; 中存在 &lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;SpawnDefaultPawnAtTransform&lt;/span&gt; 函数图。&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;若勾选 Override，BP 优先于 C++ &lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;AMGGameMode::SpawnDefaultPawnAtTransform_Implementation&lt;/span&gt;。&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;维护时确认 BP 图调用了 Parent，否则 C++ 的 PawnData 注入不会执行。&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=2;dashed=1;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="750.0" y="2001.9999999999998" width="875.0" height="140.0" />
        </mxCell>
        <mxCell id="e_restart_find" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;fontColor=#64748B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="restart" target="findStart">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e_find_world" value="ChoosePlayerStart() == nullptr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#EF4444;fontColor=#EF4444;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="findStart" target="worldSettings">
          <mxGeometry as="geometry" relative="1" />
