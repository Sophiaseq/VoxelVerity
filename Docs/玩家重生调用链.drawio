        <mxCell id="e_can_note" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;endFill=1;strokeWidth=2;strokeColor=#94A3B8;fontColor=#94A3B8;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="canRestart" target="canRestartNote">
