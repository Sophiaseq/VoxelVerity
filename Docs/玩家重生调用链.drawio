        <mxCell id="rpc" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#FFEDD5;color:#9A3412;border:1px solid #FDBA74;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;CLIENT → SERVER&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;BP_MGPlayerController::ServerRequestRespawn&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;GetGameMode() → Cast&amp;lt;AMGGameMode&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;RequestPlayerRestartNextFrame(this, bForceReset)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;资产：Content/Blueprints/Player/BP_MGPlayerController&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="525.0" y="224.0" width="487.5" height="154.0" />
        </mxCell>
        <mxCell id="warnRpc" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#FFEDD5;color:#9A3412;border:1px solid #FDBA74;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;RPC&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;网络边界：必须从 Server RPC 进入&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;GetAuthGameMode()&lt;/span&gt; 在客户端返回 &lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;nullptr&lt;/span&gt;。&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;客户端直接调用 GameMode 函数不会执行服务器逻辑。&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;检查 BP 事件是否勾选 Replicated / Run on Server。&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1075.0" y="224.0" width="550.0" height="154.0" />
        </mxCell>
        <mxCell id="resetNote" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#FEF9C3;color:#854D0E;border:1px solid #FDE047;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;IF&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;bForceReset 分支（RequestPlayerRestartNextFrame 内）&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (bForceReset &amp;amp;&amp;amp; Controller != nullptr) Controller-&amp;gt;Reset();&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;AController::Reset() → StartSpot = nullptr&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;APlayerController::Reset() → Spectating + bPlayerIsWaiting=true&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;false 时旧 StartSpot 可能保留 → FindPlayerStart 短路，跳过 ChoosePlayerStart/DeathTransforms。&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FEFCE8;strokeColor=#CA8A04;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="525.0" y="406.0" width="750.0" height="203.0" />
        </mxCell>
        <mxCell id="initNote" value="&lt;div style=&quot;text-align:left;line-height:1.35;&quot;&gt;&lt;span style=&quot;display:inline-block;background:#FFEDD5;color:#9A3412;border:1px solid #FDBA74;border-radius:3px;padding:0px 4px;margin-right:4px;font-size:10px;font-weight:bold;&quot;&gt;ASYNC&lt;/span&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-weight:bold;font-size:12px;color:#0F172A;margin-top:2px;&quot;&gt;另一入口：首次生成 / Experience 加载&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;AMGGameMode::OnExperienceLoaded()&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;for (PC : GetPlayerControllerIterator())&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;&quot;&gt;if (PC &amp;amp;&amp;amp; PC-&amp;gt;GetPawn()==nullptr &amp;amp;&amp;amp; PlayerCanRestart(PC)) RestartPlayer(PC);&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:2px;&quot;&gt;不是重生入口，但复用同一条 RestartPlayer 主链。&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=12;fontColor=#1F2937;" parent="1" vertex="1">
